<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<style>body{font-family:sans-serif;text-align:center;background:#004400;color:#fff;padding:10px} #reader{width:100%} button{width:95%;padding:25px;font-size:26px;background:#fff;color:#004400;border:none;border-radius:15px;margin:8px 0;font-weight:bold} input{padding:15px;font-size:18px;width:90%;margin:5px}</style>
</head><body>
<h1>GoGo's - STOCK IN</h1>
<div id="reader"></div>
<button onclick="startScan()">🔫 SCAN CASE TO ADD</button>
<input id="qty" type="number" value="1" placeholder="How many cases?">
<div id="msg" style="background:#000;padding:15px;border-radius:10px;margin:10px;font-size:18px">Ready</div>
<div id="learn" style="display:none;background:#ff0;color:#000;padding:15px;border-radius:10px">
NEW PRODUCT! Name it:<br>
<input id="pname" placeholder="e.g. Savanna 330ml"><br>
<input id="ppack" type="number" value="24" placeholder="Bottles per case"><br>
<button onclick="learnProduct()" style="background:#000;color:#ff0">SAVE LEARN</button>
</div>
<script>
let lastCode=''; let qr;
function startScan(){
 document.getElementById('msg').innerText='Camera opening...';
 qr=new Html5Qrcode("reader");
 qr.start({facingMode:"environment"},{fps:15,qrbox:250},(code)=>{
  qr.stop(); lastCode=code;
  let qty=document.getElementById('qty').value||1;
  fetch('/api/scan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:code,mode:'in',qty:qty})})
  .then(r=>r.json()).then(d=>{
   if(d.status=='unknown'){ document.getElementById('learn').style.display='block'; document.getElementById('msg').innerHTML='Unknown barcode: '+code; }
   else{ document.getElementById('msg').innerHTML='ADDED: '+d.product+'<br>New stock: '+d.stock; navigator.vibrate(200); setTimeout(startScan,1500); }
  });
 },()=>{});
}
function learnProduct(){
 let name=document.getElementById('pname').value;
 let pack=document.getElementById('ppack').value;
 fetch('/api/learn',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:lastCode,name:name,pack:pack})})
 .then(r=>r.json()).then(()=>{
  document.getElementById('learn').style.display='none';
  document.getElementById('msg').innerHTML='Learned: '+name;
  setTimeout(startScan,1000);
 });
}
</script>
<br><a href="/sell" style="color:#fff">Go to TILL</a>
</body></html>
